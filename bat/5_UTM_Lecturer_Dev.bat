@echo off
setlocal enabledelayedexpansion
set "ROOT=%~dp0..\.."
set "UTM=%~dp0.."
set "PYTHONPATH=%UTM%\bin;%ROOT%\bin"
title UTM Coordinate Wizard ??? Lecturer (dev)

echo.
echo  ====================================================
echo    UTM Coordinate Wizard ??? Lecturer Edition
echo    From UTM Student, For UTM Student
echo  ====================================================
echo.

cd /d "%UTM%"
set EA_EDITION=lecturer
set EA_LECTURER=1
set EA_DEV=1

:: ?????? STEP 1: Run Python installer ???????????????????????????????????????????????????????????????????????????????????????
echo  [INFO] Checking Python installation...
echo.
call "%ROOT%\bin\install_python_latest.bat"
echo.

:: ?????? Minimise bat window before launching ??????????????????????????????????????????????????????????????????
powershell -command "Add-Type -TypeDefinition 'using System;using System.Runtime.InteropServices;public class W{[DllImport(\"user32.dll\")]public static extern bool ShowWindow(IntPtr h,int n);[DllImport(\"kernel32.dll\")]public static extern IntPtr GetConsoleWindow();}';[W]::ShowWindow([W]::GetConsoleWindow(),6)" 2>nul

:: ?????? STEP 2: Launch UTM Coordinate Wizard (lecturer) ???????????????????????????
echo  [..] Launching UTM Coordinate Wizard (lecturer edition)...
echo       %UTM%\bin\utm_coordinate_wizard.py
python "%UTM%\bin\utm_coordinate_wizard.py"

if %errorlevel% neq 0 (
    echo.
    echo  [ERROR] Something went wrong. See window above.
    pause
)


